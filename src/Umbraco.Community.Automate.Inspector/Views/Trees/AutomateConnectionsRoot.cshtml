@using Umbraco.Automate.Core.Connections
@using Umbraco.Extensions
@inherits Umbraco.Community.SimpleTrees.Web.SimpleTreeViewPage
@inject ConnectionTypeCollection Connections
@{
    if (!Model.IsRoot)
    {
        var group = Model.Unique;
        var connections = Connections.Where(x => x.Group.InvariantEquals(group)).ToList();
        <uui-box headline="@group">
            @if (connections.Any())
            {
                <uui-table aria-label="Action Fields">
                    <uui-table-head>
                        <uui-table-head-cell>Name</uui-table-head-cell>
                        <uui-table-head-cell>Alias</uui-table-head-cell>
                        <uui-table-head-cell>Description</uui-table-head-cell>
                    </uui-table-head>

                    @foreach (var action in connections)
                    {
                        <uui-table-row>
                            <uui-table-cell>@action.Name</uui-table-cell>
                            <uui-table-cell>@action.Alias</uui-table-cell>
                            <uui-table-cell>@action.Description</uui-table-cell>
                        </uui-table-row>
                    }
                </uui-table>
            }
            else
            {
                <p>No connection found in this group.</p>
            }
        </uui-box>
        return;
    }
}

@if (!Connections.Any())
{
    <uui-box headline="Automate Connections">
        <p>No connections found.</p>
    </uui-box>
    return;
}

<uui-box headline="Automate Connections">
    <p>Click on the groups below to explore the available connections.</p>
</uui-box>